<odoo>
    <record id="view_users_form_simple_modif" model="ir.ui.view">
        <field name="name">res.users.preferences.form.eg_backend_theme</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences_page']" position="after">
                <page string="Appearance" name="eg_appearance" invisible="not eg_theme_available">
                    <field name="eg_company_allow_user" invisible="1" />
                    <field name="eg_theme_available" invisible="1" />
                    <div class="alert alert-info" role="alert" invisible="eg_company_allow_user">
                        Your company sets the backend appearance for everyone. Ask an administrator to allow personal customization.
                    </div>
                    <group>
                        <group name="eg_follow">
                            <field
                                name="eg_follow_company"
                                widget="boolean_toggle"
                                readonly="not eg_company_allow_user"
                            />
                        </group>
                    </group>
                    <group invisible="not eg_company_allow_user or eg_follow_company" name="eg_choices">
                        <group string="Style" name="eg_style" colspan="2">
                            <field name="eg_preset" widget="eg_theme_picker" nolabel="1" colspan="2" />
                        </group>
                        <group string="Accent color" name="eg_accent_group">
                            <field name="eg_accent" widget="eg_swatch_picker" nolabel="1" />
                        </group>
                        <group string="Surface tint" name="eg_surface_group">
                            <field name="eg_surface" widget="eg_swatch_picker" nolabel="1" />
                        </group>
                        <group string="Color scheme" name="eg_scheme_group">
                            <field name="eg_scheme" widget="eg_selection_badge" nolabel="1" />
                        </group>
                        <group string="Density" name="eg_density_group">
                            <field name="eg_density" widget="eg_selection_badge" nolabel="1" />
                        </group>
                        <group string="Navigation bar" name="eg_navbar_group">
                            <field name="eg_navbar" widget="eg_selection_badge" nolabel="1" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
